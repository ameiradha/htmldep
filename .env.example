# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Jika anda guna Custom Wildcard Domain di Vercel/Netlify (cth: *.hostanda.com)
# Isikan domain utama di bawah supaya pautan awam menjadi https://<slug-rawak>.hostanda.com
# Jika dibiarkan kosong, pautan awam automatik guna https://<domain-vercel-atau-netlify>/s/<slug-rawak>
VITE_WILDCARD_DOMAIN=""

# Optional: Override konfigurasi Firebase melalui Environment Variables Vercel/Netlify
# (Jika dibiarkan kosong, aplikasi akan guna firebase-applet-config.json secara automatik)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
